{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/editorial/**",
              "components/navigation/**",
              "components/projects/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: question, answer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|direction|size|tone|underline|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, direction, size, tone, underline."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up-right|right|down)$/]",
        "message": "<ArrowLink> direction must be one of 'up-right' | 'right' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ArrowLink> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|accent)$/]",
        "message": "<ArrowLink> tone must be one of 'primary' | 'secondary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|withArrow|icon|href|disabled|fullWidth|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, withArrow, icon, href, disabled, fullWidth, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|index|title|note|action|secondary|tone|onAction|key|ref|className|style|children)$/]",
        "message": "<ContactCTA> doesn't accept that prop. Declared props: eyebrow, index, title, note, action, secondary, tone, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactCTA'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ContactCTA> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|tone|rule|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, index, tone, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'primary' | 'secondary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|icon|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: title, body, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|radius|caption|meta|overlay|scrim|hoverZoom|placeholderLabel|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, ratio, radius, caption, meta, overlay, scrim, hoverZoom, placeholderLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|xs|sm|md|lg)$/]",
        "message": "<Figure> radius must be one of 'none' | 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageTextModule'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|eyebrow|title|body|bullets|link|linkHref|src|alt|ratio|imageSide|imageSpan|offsetText|key|ref|className|style|children)$/]",
        "message": "<ImageTextModule> doesn't accept that prop. Declared props: index, eyebrow, title, body, bullets, link, linkHref, src, alt, ratio, imageSide, imageSpan, offsetText."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageTextModule'] > JSXAttribute[name.name='imageSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ImageTextModule> imageSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageTextModule'] > JSXAttribute[name.name='imageSpan'] > Literal[value!=/^(?:wide|even)$/]",
        "message": "<ImageTextModule> imageSpan must be one of 'wide' | 'even'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|location|year|area|src|alt|ratio|size|onSelect|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: id, title, location, year, area, src, alt, ratio, size, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ProjectCard> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|separator|tone|key|ref|className|style|children)$/]",
        "message": "<ProjectMeta> doesn't accept that prop. Declared props: items, separator, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectMeta'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<ProjectMeta> tone must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionIntro'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|eyebrow|title|deck|align|level|action|key|ref|className|style|children)$/]",
        "message": "<SectionIntro> doesn't accept that prop. Declared props: index, eyebrow, title, deck, align, level, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionIntro'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:split|stack|center)$/]",
        "message": "<SectionIntro> align must be one of 'split' | 'stack' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|key|ref|className|style|children)$/]",
        "message": "<SpecRow> doesn't accept that prop. Declared props: label, value, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|location|src|rating|layout|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: quote, name, role, location, src, rating, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:beside|stacked)$/]",
        "message": "<Testimonial> layout must be one of 'beside' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|descriptor|tone|href|as|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, descriptor, tone, href, as."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
